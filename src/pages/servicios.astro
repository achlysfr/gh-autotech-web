---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterServicios from '../components/FooterServicios.astro';

// Fuente única para renderizar cards de servicio con el mismo patrón visual.
const servicios = [
  {
    icon: '/assets/iconos-servicio/icono_services_1.svg',
    titleHtml:
      '<span class="text-[#e8003e]">Mantenimiento</span><br />integral de vehículos',
    description: 'Servicios preventivos y revisiones completas.',
    alt: 'Icono de llave y tuerca representando mantenimiento de vehículos',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_2.svg',
    titleHtml:
      '<span class="text-[#e8003e]">Asesoramiento</span><br />técnico profesional',
    description: 'Te guiamos para tomar decisiones seguras.',
    alt: 'Icono de escudo representando asesoramiento técnico profesional',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_3.svg',
    titleHtml:
      'Diagnóstico<br />y reparación <span class="text-[#e8003e]">mecánica</span>',
    description: 'Solución de averías y fallos técnicos.',
    alt: 'Icono de engranajes representando diagnóstico y reparación mecánica',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_4.svg',
    titleHtml:
      'Revisión pre-<span class="text-[#e8003e]">ITV</span><br />y ajuste técnico',
    description: 'Prepara tu coche con confianza antes de la inspección oficial.',
    alt: 'Icono de checklist representando revisión pre-ITV',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_5.svg',
    titleHtml:
      'Reparación <span class="text-[#e8003e]">electrónica</span><br />y sistemas modernos',
    description: 'Desde sensores hasta sistemas integrados.',
    alt: 'Icono de chip representando reparación electrónica',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_6.svg',
    titleHtml:
      'Reparación y mejora<br />de <span class="text-[#e8003e]">componentes</span>',
    description: 'Desde frenos hasta sistemas eléctricos',
    alt: 'Icono de herramientas representando reparación y mejora de componentes',
  },
];

// ItemList + Service schema para rich results de servicios en Google.
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Servicios de taller mecánico GHAutotech en Vila-seca",
  "description": "Servicios profesionales de taller mecánico en Vila-seca (Tarragona)",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Service",
        "name": "Mantenimiento integral de vehículos",
        "description": "Servicios preventivos y revisiones completas para todo tipo de vehículos.",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Mantenimiento de vehículos"
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Service",
        "name": "Asesoramiento técnico profesional",
        "description": "Orientación experta para tomar decisiones seguras sobre tu vehículo.",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Asesoramiento técnico"
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Service",
        "name": "Diagnóstico y reparación mecánica",
        "description": "Diagnóstico preciso y solución de averías y fallos técnicos en vehículos.",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Reparación mecánica"
      }
    },
    {
      "@type": "ListItem",
      "position": 4,
      "item": {
        "@type": "Service",
        "name": "Revisión pre-ITV y ajuste técnico",
        "description": "Preparación completa del vehículo antes de la inspección técnica oficial (ITV).",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Revisión pre-ITV"
      }
    },
    {
      "@type": "ListItem",
      "position": 5,
      "item": {
        "@type": "Service",
        "name": "Reparación electrónica y sistemas modernos",
        "description": "Diagnóstico y reparación de sistemas electrónicos, sensores y computers de a bordo.",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Reparación electrónica"
      }
    },
    {
      "@type": "ListItem",
      "position": 6,
      "item": {
        "@type": "Service",
        "name": "Reparación y mejora de componentes",
        "description": "Reparación y sustitución de frenos, sistemas eléctricos y otros componentes del vehículo.",
        "provider": { "@type": "AutoRepair", "name": "GHAutotech" },
        "areaServed": { "@type": "City", "name": "Vila-seca, Tarragona" },
        "serviceType": "Reparación de componentes"
      }
    }
  ]
};

// FAQPage para rich results en búsquedas relacionadas con servicios del taller.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una revisión pre-ITV en GHAutotech?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofrecemos presupuestos personalizados para la revisión pre-ITV. Contáctanos para recibir una estimación gratuita según tu vehículo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto dura el mantenimiento de un vehículo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El tiempo de mantenimiento varía según el tipo de servicio. Desde revisiones rápidas de 30 minutos hasta mantenimientos completos que pueden tomar varias horas. Siempre te informamos del tiempo estimado previamente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacen diagnóstico de averías electrónicas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, somos especialistas en diagnóstico y reparación de sistemas electrónicos y computers de a bordo. Utilizamos tecnología avanzada para identificar y solucionar averías electrónicas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es el horario del taller?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lunes a jueves: 9:00-13:00 y 15:00-19:00. Viernes: 8:00-14:00. Sábados y domingos cerrado."
      }
    },
    {
      "@type": "Question",
      "name": "¿Necesito cita previa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recomendamos pedir cita previa para garantizar disponibilidad y reducir tiempos de espera. Puedes contactarnos por teléfono, email o a través de nuestro formulario."
      }
    }
  ]
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<Layout
  title="Servicios de taller mecánico en Vila-seca"
  description="Servicios de taller mecánico en Vila-seca (Tarragona): mantenimiento integral, diagnóstico técnico, reparación mecánica y electrónica, revisión pre-ITV y asesoramiento profesional."
>
  <Header />

  <main class="flex-grow">
    <!-- HERO VIDEO -->
    <section class="relative min-h-[640px] lg:h-[92svh] max-h-[980px] bg-black overflow-hidden flex items-center pt-[72px] md:pt-[114px]">
      <div class="absolute inset-0 w-full h-full" aria-hidden="true">
        <video
          class="absolute inset-0 w-full h-full object-cover object-center lazy-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          style="opacity:0;transition:opacity 0.7s ease;"
        >
          <source data-src="/assets/videos/AdobeStock_898118759.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-black/30 pointer-events-none" aria-hidden="true"></div>
      </div>

      <div
        class="relative z-10 w-full"
        style="padding-left: clamp(24px, 12vw, 310px); padding-right: var(--site-gutter);"
      >
        <div class="max-w-[720px] flex flex-col gap-6">
          <h1
            class="text-white uppercase font-extrabold leading-tight tracking-[-0.06em] text-[clamp(28px,4vw,44px)]"
          >
            Servicios de Taller<br />
            Mecánico y Mantenimiento<br />
            de Vehículos
          </h1>

          <p
            class="text-white font-medium leading-normal text-[clamp(16px,1.5vw,18px)]"
          >
            Ofrecemos una gama completa de servicios automotrices profesionales para cubrir todas las necesidades de mantenimiento y reparación de tu coche. Nuestro equipo experto se encarga de cada detalle para garantizar el mejor rendimiento, seguridad y durabilidad de tu vehículo.
          </p>

          <!-- Navigation Arrow -->
          <div class="mt-10 sm:mt-14 md:mt-20 pl-6 sm:pl-8">
            <a
              href="#servicios-contenido"
              class="inline-block hover:translate-y-2 transition-transform duration-300"
              aria-label="Explorar más servicios"
            >
              <img
                src="/assets/images/sobre-nosotros/ARROW.svg"
                alt="Flecha animada para explorar servicios"
                class="w-[40px] md:w-[60px] h-auto"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES GRID -->
    <section
      id="servicios-contenido"
      class="bg-black scroll-mt-[72px] md:scroll-mt-[114px] min-h-[calc(92svh-72px)] md:min-h-[calc(92svh-114px)] py-16 sm:py-20 flex items-center"
    >
      <div class="site-container w-full">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-24 lg:gap-x-64 gap-y-12 sm:gap-y-14 md:gap-y-20 lg:gap-y-28">
          {servicios.map((s) => (
            <div class="flex gap-6 sm:gap-8 items-start">
              <div class="shrink-0 pt-1">
                <img
                  src={s.icon}
                  alt={s.alt}
                  class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="min-w-0">
                <h2
                  class="text-white uppercase font-black leading-[1.2] md:leading-[1.05] tracking-[-0.02em] text-[28px] sm:text-[32px] md:text-[34px]"
                  set:html={s.titleHtml}
                />
                <p class="mt-2 text-white/75 text-sm sm:text-base leading-snug">
                  {s.description}
                </p>
              </div>
            </div>
          ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterServicios />
</Layout>
