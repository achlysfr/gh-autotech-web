---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterServicios from '../components/FooterServicios.astro';

const servicios = [
  {
    icon: '/assets/iconos-servicio/icono_services_1.svg',
    titleHtml:
      '<span class="text-[#e8003e]">Mantenimiento</span><br />integral de vehículos',
    description: 'Servicios preventivos y revisiones completas.',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_2.svg',
    titleHtml:
      '<span class="text-[#e8003e]">Asesoramiento</span><br />técnico profesional',
    description: 'Te guiamos para tomar decisiones seguras.',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_3.svg',
    titleHtml:
      'Diagnóstico<br />y reparación <span class="text-[#e8003e]">mecánica</span>',
    description: 'Solución de averías y fallos técnicos.',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_4.svg',
    titleHtml:
      'Revisión pre-<span class="text-[#e8003e]">ITV</span><br />y ajuste técnico',
    description: 'Prepara tu coche con confianza antes de la inspección oficial.',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_5.svg',
    titleHtml:
      'Reparación <span class="text-[#e8003e]">electrónica</span><br />y sistemas modernos',
    description: 'Desde sensores hasta sistemas integrados.',
  },
  {
    icon: '/assets/iconos-servicio/icono_services_6.svg',
    titleHtml:
      'Reparación y mejora<br />de <span class="text-[#e8003e]">componentes</span>',
    description: 'Desde frenos hasta sistemas eléctricos',
  },
];
---

<Layout title="Servicios">
  <Header />

  <main class="flex-grow">
    <!-- HERO VIDEO -->
    <section class="relative min-h-[640px] lg:h-[92svh] max-h-[980px] bg-black overflow-hidden flex items-center pt-[72px] md:pt-[114px]">
      <div class="absolute inset-0 w-full h-full" aria-hidden="true">
        <video
          class="absolute inset-0 w-full h-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="/assets/videos/AdobeStock_898118759.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-black/30 pointer-events-none" aria-hidden="true"></div>
      </div>

      <div
        class="relative z-10 w-full"
        style="padding-left: clamp(24px, 12vw, 310px); padding-right: var(--site-gutter);"
      >
        <div class="max-w-[720px] flex flex-col gap-6">
          <h1
            class="text-white uppercase"
            style="height: 159px; align-self: stretch; font-family: 'Public Sans'; font-size: 40px; font-style: normal; font-weight: 800; line-height: normal; letter-spacing: -2.4px;"
          >
            Servicios de Taller<br />
            Mecánico y Mantenimiento<br />
            de Vehículos
          </h1>

          <p
            class="text-white"
            style="height: 159px; align-self: stretch; font-family: 'Public Sans'; font-size: 22px; font-style: normal; font-weight: 500; line-height: normal;"
          >
            Ofrecemos una gama completa de servicios automotrices profesionales para cubrir todas las necesidades de mantenimiento y reparación de tu coche. Nuestro equipo experto se encarga de cada detalle para garantizar el mejor rendimiento, seguridad y durabilidad de tu vehículo.
          </p>

          <!-- Navigation Arrow -->
          <div class="mt-10 sm:mt-14 md:mt-20 pl-6 sm:pl-8">
            <a
              href="#servicios-contenido"
              class="inline-block hover:translate-y-2 transition-transform duration-300"
              aria-label="Explorar más"
            >
              <img
                src="/assets/images/sobre-nosotros/ARROW.svg"
                alt="Explorar más"
                class="w-[40px] md:w-[60px] h-auto"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES GRID -->
    <section
      id="servicios-contenido"
      class="bg-black scroll-mt-[72px] md:scroll-mt-[114px] min-h-[calc(92svh-72px)] md:min-h-[calc(92svh-114px)] pt-20 sm:pt-24 pb-16 sm:pb-20 flex"
    >
      <div class="site-container w-full flex">
        <div class="w-full flex flex-col justify-between pl-6 sm:pl-10 md:pl-14 lg:pl-16 pt-4 sm:pt-6">
          <div class="grid flex-1 h-full grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-24 gap-y-10 sm:gap-y-12 md:gap-y-0 md:grid-rows-3 md:auto-rows-fr">
          {servicios.map((s) => (
            <div class="flex gap-6 sm:gap-8 items-start">
              <div class="shrink-0 pt-1">
                <img
                  src={s.icon}
                  alt=""
                  aria-hidden="true"
                  class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="min-w-0">
                <h2
                  class="text-white uppercase font-black leading-[1.05] tracking-[-0.02em] text-[28px] sm:text-[32px] md:text-[34px]"
                  set:html={s.titleHtml}
                />
                <p class="mt-2 text-white/75 text-sm sm:text-base leading-snug">
                  {s.description}
                </p>
              </div>
            </div>
          ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterServicios />
</Layout>

