---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Horario y Contacto">
  <Header />

  <main class="flex-grow pt-24 space-y-24">
    <ContactForm />

    <section class="bg-gray-950 text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-red-500 mb-6 relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-1/2 after:h-0.5 after:bg-red-600">
          Horario
        </h2>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 max-w-xl">
          <ul class="space-y-4 text-sm">
            <li class="flex justify-between items-center border-b border-gray-800 pb-3">
              <span class="text-gray-400">Lunes - Jueves</span>
              <div class="text-right font-medium">
                <span class="block">8:00H - 14:00H</span>
                <span class="block text-red-500">15:00H - 19:00H</span>
              </div>
            </li>
            <li class="flex justify-between items-center pt-1">
              <span class="text-gray-400">Viernes</span>
              <span class="font-medium text-red-500 bg-red-600/10 px-3 py-1 rounded-md">9:00H - 13:00H</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

