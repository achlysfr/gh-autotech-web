---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contacto y horario | Taller en Vila-seca"
  description="Consulta el horario y contacto de GHAutotech en Vila-seca (Tarragona). Llámanos, escríbenos o visítanos en Av. de la Generalitat, 43F para pedir cita."
>
  <Header />

  <main class="flex-grow pt-[72px] md:pt-[114px]">
    <section class="bg-white min-h-[calc(100svh-72px)] md:min-h-[calc(100svh-114px)] flex items-center">
      <div class="site-container">
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

          <div class="flex justify-center">
            <img
              src="/assets/images/maps/map-catalonia.svg"
              alt="Mapa de Cataluña"
              class="w-full max-w-[420px] sm:max-w-[520px] md:max-w-[620px] lg:max-w-[680px] h-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col justify-center space-y-10 text-black">

            <div class="flex gap-5">
              <img
                src="/assets/images/horario-iconos/horario-icono.svg"
                alt=""
                aria-hidden="true"
                class="w-10 h-10 md:w-12 md:h-12 shrink-0"
                loading="lazy"
                decoding="async"
              />

              <div class="flex flex-col sm:flex-row gap-8 sm:gap-14">

                <div class="leading-tight">
                  <p class="font-black uppercase text-2xl md:text-3xl tracking-tight mb-1">
                    Lunes-Jueves
                  </p>
                  <p class="text-xl md:text-2xl font-bold">9:00H - 13:00H</p>
                  <p class="text-xl md:text-2xl font-bold">15:00H - 19:00H</p>
                </div>

                <div class="leading-tight">
                  <p class="font-black uppercase text-2xl md:text-3xl tracking-tight mb-1">
                    Viernes
                  </p>
                  <p class="text-xl md:text-2xl font-bold">9:00H - 14:00H</p>
                </div>

              </div>
            </div>

            <div class="flex gap-5 items-center">
              <img
                src="/assets/images/horario-iconos/mail-icono.svg"
                alt=""
                aria-hidden="true"
                class="w-10 h-10 md:w-12 md:h-12 shrink-0"
                loading="lazy"
                decoding="async"
              />
              <p class="text-xl md:text-2xl font-bold break-all">
                administracion@ghautotech.com
              </p>
            </div>

            <div class="flex gap-5 items-center">
              <img
                src="/assets/images/horario-iconos/telefono-icono.svg"
                alt=""
                aria-hidden="true"
                class="w-10 h-10 md:w-12 md:h-12 shrink-0"
                loading="lazy"
                decoding="async"
              />
              <p class="text-xl md:text-2xl font-bold">
                +34 630 473 852
              </p>
            </div>

            <div class="flex gap-5 items-start">
              <img
                src="/assets/images/horario-iconos/localizacion-icono.svg"
                alt=""
                aria-hidden="true"
                class="w-10 h-10 md:w-12 md:h-12 shrink-0"
                loading="lazy"
                decoding="async"
              />
              <p class="text-xl md:text-2xl font-bold leading-tight">
                AV. de la Generalitat, 43F<br />
                43480 Vila-Seca<br />
                (Tarragona) España
              </p>
            </div>

          </div>

        </div>

        <div class="mt-10 sm:mt-12 md:mt-16 flex justify-center">
          <a
            href="#contacto"
            class="inline-flex hover:translate-y-2 transition-transform duration-300"
            aria-label="Ir a la sección de contacto"
          >
            <img
              src="/assets/images/horario-iconos/Arrow-horario.svg"
              alt="Explorar más"
              class="w-12 sm:w-16 h-auto"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </section>

    <section id="contacto" class="bg-[#135C8A] py-14 sm:py-16 lg:py-20 scroll-mt-[72px] md:scroll-mt-[114px]">
      <div class="max-w-[1280px] w-full mx-auto px-6 sm:px-8 lg:px-12">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

          <div class="text-white">
            <h2 class="font-sans text-[clamp(2.25rem,5vw,4.0625rem)] leading-[1] tracking-[-0.045em] font-normal max-w-[560px]">
              ¿Necesitas revisar<br />
              tu vehículo o solicitar<br />
              <span class="font-bold">
                información
              </span>
              sobre<br />
              nuestros servicios?
            </h2>

            <p class="mt-6 max-w-[480px] text-[16px] sm:text-[18px] leading-snug tracking-[-0.02em] text-white/90">
              En GHAutotech estamos aquí para ayudarte.
              Nuestro equipo estará encantado de asesorarte
              y ofrecerte la mejor solución para tu vehículo.
            </p>
          </div>

          <form
            class="w-full max-w-[520px] flex flex-col gap-4 lg:ml-auto"
            method="POST"
            action="https://formsubmit.co/administracion@ghautotech.com"
          >
            <input type="hidden" name="_subject" value="Nuevo mensaje desde ghautotech.com" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />

            <input
              type="text"
              name="nombre"
              placeholder="Nombre"
              class="w-full border border-white/70 bg-transparent px-5 py-3 text-white placeholder-white/70 focus:outline-none focus:border-white"
              required
            />

            <input
              type="tel"
              name="telefono"
              placeholder="Teléfono"
              class="w-full border border-white/70 bg-transparent px-5 py-3 text-white placeholder-white/70 focus:outline-none focus:border-white"
              required
            />

            <textarea
              rows="5"
              name="mensaje"
              placeholder="Mensaje"
              class="w-full border border-white/70 bg-transparent px-5 py-3 text-white placeholder-white/70 resize-none focus:outline-none focus:border-white"
              required
            ></textarea>

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
              <label class="flex items-start gap-3 text-sm max-w-[320px] text-white/90 cursor-pointer">
                <input type="checkbox" class="mt-1 accent-[#e8003e] w-5 h-5 cursor-pointer" required />
                <span>
                  Entiendo que los datos solicitados no se almacenan y solo se utilizan para enviar el mensaje al responsable de la web.
                </span>
              </label>

              <button
                type="submit"
                class="bg-white text-black px-8 py-3 font-bold uppercase tracking-[0.25em] hover:bg-gray-200 transition"
              >
                Enviar
              </button>
            </div>
          </form>

        </div>

      </div>
    </section>

    <section class="flex items-stretch justify-center overflow-hidden">
      <div class="w-full">
        <div class="relative w-full aspect-[2117.96/1412.15] max-h-[80svh]">
          <img
            src="/assets/images/horario-iconos/imagen-taller.jpg"
            alt="Fachada del taller GHAutotech"
            class="w-full h-full object-cover [transform:rotate(0.721deg)_scale(1.03)]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>