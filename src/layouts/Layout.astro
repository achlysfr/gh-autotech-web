---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Taller mecánico profesional en Vila-seca, Tarragona. Te guiamos para tomar decisiones seguras sobre tu vehículo." } = Astro.props;
// Canonical absoluto para evitar contenido duplicado entre rutas con/sin trailing slash.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const siteUrl = Astro.site ? Astro.site.toString() : undefined;
const ogImagePath = "/assets/images/sobre-nosotros/imagen-portada.jpg";
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).toString() : ogImagePath;

// Schema global de negocio local; se inyecta en todas las páginas para reforzar SEO local.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "GHAutotech",
  "description": "Taller mecánico profesional en Vila-seca especializado en reparación, mantenimiento y diagnóstico de vehículos.",
  "url": siteUrl,
  "telephone": "+34 630 473 852",
  "email": "administracion@ghautotech.com",
  "priceRange": "€€",
  "image": siteUrl ? new URL("/assets/brand/logo-ghautotech.svg", Astro.site).toString() : undefined,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "AV. de la Generalitat, 43F",
    "postalCode": "43480",
    "addressLocality": "Vila-Seca",
    "addressRegion": "Tarragona",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "41.1171",
    "longitude": "1.1442"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "09:00",
      "closes": "13:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "15:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Friday",
      "opens": "08:00",
      "closes": "14:00"
    }
  ],
  "alternateName": "Taller mecánico Vilaseca",
  "hasMap": "https://www.google.com/maps/search/GHAutotech/@41.1171,1.1442,17z",
  "areaServed": [
    "Vila-seca", "Salou", "La Pineda", "Tarragona", "Reus",
    "Cambrils", "La Canonja", "Altafulla", "Torredembarra", "El Morell"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+34-630-473-852",
    "contactType": "customer service",
    "availableLanguage": ["Spanish", "Catalan"],
    "areaServed": [
      "Vila-seca", "Salou", "La Pineda", "Tarragona", "Reus",
      "Cambrils", "La Canonja", "Altafulla", "Torredembarra", "El Morell"
    ]
  },
  "sameAs": [
    "https://www.instagram.com/ghautotech/",
    "https://www.facebook.com/ghautotech/"
  ]
};

// Breadcrumb básico: Inicio + página actual (si no es home).
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    ...(Astro.url.pathname !== "/" ? [{
      "@type": "ListItem",
      "position": 2,
      "name": title.split(" | ")[0],
      "item": canonicalUrl
    }] : [])
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-black">
	<head>
		<meta charset="UTF-8" />

		<!-- Google Consent Mode v2: denegar por defecto hasta obtener consentimiento explícito (GDPR) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('consent', 'default', {
				'analytics_storage': 'denied',
				'ad_storage': 'denied',
				'functionality_storage': 'denied',
				'personalization_storage': 'denied',
				'security_storage': 'granted'
			});
			if (typeof localStorage !== 'undefined' && localStorage.getItem('cookie_consent') === 'accepted') {
				gtag('consent', 'update', {
					'analytics_storage': 'granted',
					'ad_storage': 'granted'
				});
			}
		</script>
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WTBZ9C2K');</script>
		<!-- End Google Tag Manager -->
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<meta name="author" content="GHAutotech" />
		<meta name="keywords" content="taller mecánico Vila-seca, talleres Vila-seca, talleres Vilaseca, taller mecánico Vilaseca, reparación coches Tarragona, mantenimiento vehículos, diagnóstico averías, ITV pre-revisión, mecánica electricidad electrónica, taller multimarca Vila-Seca, reparacion coche Costa Daurada" />
		<meta name="geo.region" content="ES-T" />
		<meta name="geo.placename" content="Vila-seca" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon_gh.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		<title>{title} | GHAutotech</title>

		<link rel="preconnect" href="https://cdnjs.cloudflare.com" />
		<link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

		<meta property="og:title" content={`${title} | GHAutotech`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta property="og:site_name" content="GHAutotech" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="GHAutotech – Taller mecánico en Vila-seca (Tarragona)" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | GHAutotech`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="GHAutotech – Taller mecánico en Vila-seca (Tarragona)" />
		<meta name="theme-color" content="#e8003e" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
		{canonicalUrl && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
	</head>
	<body class="bg-black text-black antialiased selection:bg-[#e8003e] selection:text-white flex flex-col min-h-screen">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WTBZ9C2K"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<slot />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const lazyVideos = document.querySelectorAll('video.lazy-video');

				if ('IntersectionObserver' in window) {
					const videoObserver = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									const video = entry.target as HTMLVideoElement;
									const source = video.querySelector('source');
									if (source?.dataset.src) {
										source.src = source.dataset.src;
										video.load();
										video.play().catch(() => {});
									}
									video.classList.remove('lazy-video');
									videoObserver.unobserve(video);
								}
							});
						},
						{ rootMargin: '50px' }
					);

					lazyVideos.forEach((video) => videoObserver.observe(video));
				} else {
					lazyVideos.forEach((el) => {
						const video = el as HTMLVideoElement;
						const source = video.querySelector('source');
						if (source?.dataset.src) {
							source.src = source.dataset.src;
							video.load();
							video.play().catch(() => {});
						}
					});
				}
			});
		</script>
		<CookieBanner />
	</body>
</html>
