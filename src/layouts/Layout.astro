---
// Archivo base de layout
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Taller mecánico profesional en Vila-seca, Tarragona. Te guiamos para tomar decisiones seguras sobre tu vehículo." } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImagePath = "/assets/images/sobre-nosotros/imagen-portada.jpg";
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).toString() : ogImagePath;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow" />
		<meta name="author" content="GHAutotech" />
		<meta name="geo.region" content="ES-T" />
		<meta name="geo.placename" content="Vila-seca" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		<title>{title} | GHAutotech</title>

		<!-- SEO -->
		<meta property="og:title" content={`${title} | GHAutotech`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta property="og:site_name" content="GHAutotech" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="GHAutotech – Taller mecánico en Vila-seca (Tarragona)" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | GHAutotech`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="theme-color" content="#000000" />

		<script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutoRepair",
      name: "GHAutotech",
      url: Astro.site ? Astro.site.toString() : undefined,
      telephone: "+34 630 473 852",
      email: "administracion@ghautotech.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "AV. de la Generalitat, 43F",
        postalCode: "43480",
        addressLocality: "Vila-Seca",
        addressRegion: "Tarragona",
        addressCountry: "ES"
      }
    })} />
		
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	</head>
	<body class="bg-white text-black antialiased selection:bg-[#e8003e] selection:text-white flex flex-col min-h-screen">
		<slot />
	</body>
</html>
